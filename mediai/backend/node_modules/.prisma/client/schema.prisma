datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  role           String // 'PATIENT', 'DOCTOR', 'ADMIN', 'STAFF'
  createdAt      DateTime        @default(now())
  isActive       Boolean         @default(true)
  patient        Patient?
  doctor         Doctor?
  staffSchedules StaffSchedule[]
  notifications  Notification[]
  chatSessions   ChatSession[]

  @@index([email])
}

model Patient {
  id                       String                    @id @default(uuid())
  userId                   String                    @unique
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                      Int
  gender                   String
  bloodGroup               String
  weight                   Float
  height                   Float
  allergies                String
  medicalHistory           String
  familyHistory            String
  insuranceDetails         String
  createdAt                DateTime                  @default(now())
  appointments             Appointment[]
  ehrs                     EHR[]
  labReports               LabReport[]
  diseasePredictions       DiseasePrediction[]
  treatmentRecommendations TreatmentRecommendation[]
  patientOutcomes          PatientOutcome[]
  alerts                   Alert[]
  beds                     Bed[]
}

model Doctor {
  id                       String                    @id @default(uuid())
  userId                   String                    @unique
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization           String
  department               String
  experience               Int
  qualification            String
  licenseNumber            String                    @unique
  availableSlots           String // Array of ISO timestamps
  createdAt                DateTime                  @default(now())
  appointments             Appointment[]
  ehrs                     EHR[]
  treatmentRecommendations TreatmentRecommendation[]
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      String   @default("PENDING") // 'PENDING', 'CONFIRMED', 'CANCELLED', 'COMPLETED'
  notes       String?
  createdAt   DateTime @default(now())

  @@index([patientId])
  @@index([doctorId])
}

model EHR {
  id                 String   @id @default(uuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  prescriptions      String // JSON array of medications/dosages
  diagnosticReports  String // JSON array of test results
  treatmentHistory   String // JSON array of past therapies/treatments
  vaccinationRecords String // JSON array of vaccines
  updatedAt          DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
}

model LabReport {
  id             String   @id @default(uuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reportType     String
  fileUrl        String
  analysisResult String // JSON representation of OCR/NLP metrics
  abnormalFlags  String // JSON array of abnormal metrics
  uploadedAt     DateTime @default(now())

  @@index([patientId])
}

model DiseasePrediction {
  id               String   @id @default(uuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptoms         String // JSON array of symptoms
  inputs           String // JSON of vital signs & numeric parameters
  predictedDisease String
  riskScore        Float
  severityLevel    String
  modelUsed        String
  createdAt        DateTime @default(now())

  @@index([patientId])
}

model TreatmentRecommendation {
  id                   String   @id @default(uuid())
  patientId            String
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId             String
  doctor               Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  recommendedTreatment String // JSON details of recovery plan
  suggestedTests       String // JSON array of diagnostic tests
  medicationGuidance   String // JSON guidance on schedules/dosages
  createdAt            DateTime @default(now())

  @@index([patientId])
  @@index([doctorId])
}

model PatientOutcome {
  id                  String   @id @default(uuid())
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recoveryProbability Float
  icuRequired         Boolean
  readmissionRisk     Float
  mortalityRisk       Float
  expectedStayDays    Int
  createdAt           DateTime @default(now())

  @@index([patientId])
}

model Bed {
  id            String    @id @default(uuid())
  wardType      String // 'GENERAL', 'ICU', 'EMERGENCY', 'PRIVATE'
  isOccupied    Boolean   @default(false)
  patientId     String?
  patient       Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  reservedUntil DateTime?

  @@index([patientId])
}

model StaffSchedule {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftStart    DateTime
  shiftEnd      DateTime
  role          String
  department    String
  autoGenerated Boolean  @default(false)

  @@index([userId])
}

model Resource {
  id             String   @id @default(uuid())
  resourceType   String // 'VENTILATOR', 'OXYGEN', 'EQUIPMENT'
  totalUnits     Int
  availableUnits Int
  lastUpdated    DateTime @updatedAt
}

model Alert {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  alertType  String // 'CRITICAL', 'EMERGENCY', 'MEDICATION', 'LAB_REPORT'
  message    String
  isResolved Boolean  @default(false)
  notifiedAt DateTime @default(now())

  @@index([patientId])
}

model Notification {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  body    String
  channel String // 'EMAIL', 'SMS', 'WHATSAPP', 'PUSH'
  sentAt  DateTime @default(now())
  isRead  Boolean  @default(false)

  @@index([userId])
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  String // JSON array of messages (role + content)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
