# ==============================================================================
# MEDIAI ENVIRONMENT CONFIGURATION BLUEPRINT
# Copy this file to '.env' and adjust values for local development
# ==============================================================================

# Node.js Run Environment Configuration
NODE_ENV=development
PORT=5000

# Database Connections (Primary PostgreSQL)
# Local Dev default: postgresql://postgres:postgrespassword@localhost:5432/mediaidb?schema=public
# Docker Dev default: postgresql://postgres:postgrespassword@postgres:5432/mediaidb?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/mediaidb?schema=public

# Caching & Session Store (Redis)
# Local Dev default: redis://localhost:6379
# Docker Dev default: redis://redis:6379
REDIS_URL=redis://localhost:6379

# JSON Web Tokens (Authentication Security)
JWT_SECRET=super_secret_cryptographic_signing_key_change_me_in_production
JWT_EXPIRES_IN=24h

# FastAPI Microservice endpoint
AI_SERVICE_URL=http://localhost:8000

# OpenAI API (Langchain Chatbot) - Leave empty to use rule-based fallback
OPENAI_API_KEY=your_openai_api_key_here

# Cloudinary (Diagnostic scans files storage) - Leave empty to use local fallback
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Twilio (Emergency SMS dispatches) - Leave empty to use console logger mock
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Nodemailer / SMTP (Patient notifications) - Leave empty to use console logger mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
